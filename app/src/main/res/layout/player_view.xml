<?xml version="1.0" encoding="utf-8"?>
<!--
  Media3 PlayerView with a TextureView surface. This screen hosts the player
  inside a Compose AndroidView; a SurfaceView lives in its own compositor layer
  behind the app window and relies on hole-punching to show through, which is
  unreliable under Compose (opaque backgrounds / animated layers hide it → black
  frame even while the decoder is actively decoding). A TextureView composites
  the decoded frames directly into the view hierarchy, so it renders reliably in
  Compose. (The x86 emulator cannot render either path due to its gralloc surface
  bug — an emulator limitation, not a code issue.)
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
